{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://hardwood-replied-speak-wendy.trycloudflare.com/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://hardwood-replied-speak-wendy.trycloudflare.com/uploads/$1"
    },
    {
      "source": "/share",
      "destination": "https://hardwood-replied-speak-wendy.trycloudflare.com/api/share"
    },
    {
      "source": "/share/(.*)",
      "destination": "https://hardwood-replied-speak-wendy.trycloudflare.com/api/share/$1"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ]
