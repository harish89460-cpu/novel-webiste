  "chapters": [
    {
      "id": 1,
      "novel_id": "nenjam-marappadhillai",
      "chapter_num": 1,
      "title": "Chapter 01 — Beginning of Dawn",
      "title_ta": "Chapter 01 — Beginning of Dawn",
      "content": "The morning mist drifted lazily across the veranda as Varshini held her porcelain cup, listening to the quiet rhythm of the dawn. Though countless memories echoed within, her expression remained calm and poised.\n\nLittle did she know that today would mark the beginning of a decisive chapter in her journey. The distant hum of the morning express train seemed to announce a destiny already unfolding.\n\n\"Varshini, are you ready?\" Her mother's warm voice drew her back into the present. With a soft smile, she nodded. The next chapter of life was finally about to begin.",
      "is_guest_allowed": 1,
      "is_audio": 0,
      "word_count": "2,450 words",
      "read_time": "7 mins",
      "release_date": "12 Oct 2025",
      "created_at": "2026-10-18 10:55:10",
      "updated_at": "2026-10-18 10:55:10"
    },
    {
      "id": 2,
      "novel_id": "nenjam-marappadhillai",
      "chapter_num": 2,
      "title": "Chapter 02 — Waves of Memory",
      "title_ta": "Chapter 02 — Waves of Memory",
      "content": "The bustling train station was bathed in amber morning light. As the train rolled in with a metallic roar, Varshini stepped onto the platform, luggage in hand.\n\nMemories of her childhood summers rushed back—the endless green fields, the ancestral home, and the promises made under the grand banyan tree. But the face she remembered most vividly was the one she had tried so hard to forget.\n\n\"Could he still be here?\" she whispered quietly to herself, tightening her grip on her shawl as a sudden gust of wind swept through the platform.",
      "is_guest_allowed": 1,
      "is_audio": 0,
      "word_count": "2,600 words",
      "read_time": "8 mins",
      "release_date": "19 Oct 2025",
      "created_at": "2026-10-18 10:55:10",
      "updated_at": "2026-10-18 10:55:10"
    },
    {
      "id": 3,
      "novel_id": "nenjam-marappadhillai",
      "chapter_num": 3,
      "title": "Chapter 03 — Unexpected Meeting",
      "title_ta": "Chapter 03 — Unexpected Meeting",
      "content": "The village courtyard was alive with familiar laughter. Family members greeted her with warm embraces and traditional sweets. Yet across the courtyard, near the carved wooden doorway, stood a tall figure with sharp, thoughtful eyes.\n\nTheir eyes met across the crowded hall. Time seemed to pause for a breathless second. It was him—Devan. He had matured, but that intense gaze remained unchanged.\n\nHe offered a slow, courteous nod, acknowledging her return with an unspoken depth that made her pulse quicken.",
      "is_guest_allowed": 1,
      "is_audio": 0,
      "word_count": "2,820 words",
      "read_time": "8 mins",
      "release_date": "26 Oct 2025",
      "created_at": "2026-10-18 10:55:10",
      "updated_at": "2026-10-18 10:55:10"
    },
    {
      "id": 4,
      "novel_id": "nenjam-marappadhillai",
      "chapter_num": 24,
      "title": "Chapter 24 — Truth in the Heart",
      "title_ta": "Chapter 24 — Truth in the Heart",
      "content": "The rain poured down steadily outside the study window, drumming against the glass like a long-kept secret finally demanding release.\n\nVarshini placed the old journal onto the table. \"You knew all along, didn't you, Devan?\"\n\nDevan turned, the dim desk lamp illuminating his resolute face. \"Some truths are withheld not to deceive, Varshini, but to protect what matters most.\"\n\nFor the first time in ten years, the wall between them crumbled. In the silence that followed, both understood that life had given them a second chance.",
      "is_guest_allowed": 1,
      "is_audio": 0,
      "word_count": "3,120 words",
      "read_time": "10 mins",
      "release_date": "08 Oct 2026",
      "created_at": "2026-10-18 10:55:10",
      "updated_at": "2026-10-18 10:55:10"
    },
    {
      "id": 5,
      "novel_id": "kaadhal-konden-kanave",
      "chapter_num": 1,
      "title": "Chapter 01 — Dream Journey",
      "title_ta": "Chapter 01 — Dream Journey",
      "content": "In the quiet glow of twilight, dreams often weave paths that reality hesitates to tread. Ananya sketched the riverbank in her notebook, watching the twilight colors blend into indigo.\n\nShe had always believed in the power of destiny. When an unfamiliar shadow crossed the pathway, she looked up, surprised to find someone admiring her artwork.\n\n\"You capture the light remarkably well,\" a voice murmured. That single sentence would change everything.",
      "is_guest_allowed": 1,
      "is_audio": 0,
      "word_count": "2,200 words",
      "read_time": "6 mins",
      "release_date": "15 Jan 2026",
      "created_at": "2026-10-18 10:55:10",
      "updated_at": "2026-10-18 10:55:10"
    },
    {
      "id": 6,
      "novel_id": "kaadhal-konden-kanave",
      "chapter_num": 18,
      "title": "Chapter 18 — Soft Touch",
      "title_ta": "Chapter 18 — Soft Touch",
      "content": "Standing atop the hilltop temple stairs, the city lights spread beneath them like an ocean of fallen stars.\n\n\"Do you still doubt what we have?\" Siddharth asked softly, reaching out to hold her hand in the cool night air.\n\nAnanya looked into his eyes and felt the doubts of months evaporate into the night breeze. With a gentle nod, she knew they were ready to face whatever family challenges lay ahead.",
      "is_guest_allowed": 1,
      "is_audio": 0,
      "word_count": "2,900 words",
      "read_time": "9 mins",
      "release_date": "07 Oct 2026",
      "created_at": "2026-10-18 10:55:10",
      "updated_at": "2026-10-18 10:55:10"
    },
    {
      "id": 7,
      "novel_id": "uyire-unakkaga",
      "chapter_num": 1,
      "title": "Chapter 01 — Motherhood Lullaby",
      "title_ta": "Chapter 01 — Motherhood Lullaby",
      "content": "The aroma of freshly ground spices filled the small kitchen where Meenakshi Amma worked tirelessly before the break of dawn.\n\nHer three children slept soundly in the next room, oblivious to the financial burdens she bore alone since her husband's untimely passing. Every sacrifice, every silent tear, was dedicated to ensuring their dignity and future.\n\n\"As long as I draw breath, my children will hold their heads high,\" she whispered as the morning sun crowned the horizon.",
      "is_guest_allowed": 1,
      "is_audio": 0,
      "word_count": "3,100 words",
      "read_time": "9 mins",
      "release_date": "01 Mar 2025",
      "created_at": "2026-10-18 10:55:10",
      "updated_at": "2026-10-18 10:55:10"
    },
    {
      "id": 8,
      "novel_id": "uyire-unakkaga",
      "chapter_num": 45,
      "title": "Chapter 45 — Blissful Conclusion",
      "title_ta": "Chapter 45 — Blissful Conclusion",
      "content": "The grand university auditorium was filled with thunderous applause as her son stepped forward to receive his doctorate, bowing low to touch Meenakshi's feet.\n\nTears of profound joy rolled down her weathered cheeks. Her children had reached heights greater than she had ever dared to dream. The sacrifices of a lifetime had borne the sweetest fruit.",
      "is_guest_allowed": 1,
      "is_audio": 0,
      "word_count": "4,000 words",
      "read_time": "12 mins",
      "release_date": "15 Dec 2025",
