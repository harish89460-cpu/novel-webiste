# ==============================================================================
# Rudhra Prarthana Novels — Production Environment Configuration Template
# ==============================================================================
# Rename or copy this file to '.env' on the new production server and fill in
# your actual hosting and database credentials. Never commit '.env' to git.

# ------------------------------------------------------------------------------
# 1. Application Server Configuration
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 2. Production MySQL Database Connection
# ------------------------------------------------------------------------------
# Specify individual parameters:
DB_HOST=localhost
DB_PORT=3306
DB_USER=rp_novels_user
DB_PASSWORD=your_strong_mysql_password_here
DB_NAME=rp_novels_db

# Optional: If your cloud provider uses SSL (e.g. AWS RDS, DigitalOcean, Cloud SQL):
DB_SSL=false
# DB_SSL_CA=/path/to/ca-certificate.pem
# DB_SSL_REJECT_UNAUTHORIZED=true

# Alternative: If using a unified connection URI (e.g. Railway, Render, Heroku):
# DATABASE_URL=mysql://user:password@host:3306/database_name?ssl=true

# ------------------------------------------------------------------------------
# 3. SMTP Email Service (for Admin Password Reset & Two-Factor OTP)
# ------------------------------------------------------------------------------
# Gmail example with App Password (Google Account > Security > 2-Step Verification > App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_admin_smtp_email@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM="Rudhra Prarthana Novels" <your_admin_smtp_email@gmail.com>

# ------------------------------------------------------------------------------
# 4. Web Push Notification Configuration (VAPID)
# ------------------------------------------------------------------------------
VAPID_PUBLIC_KEY=BCK-55p--iO8wkCpzGcGvdrYWp9ruekz8jnSSt--PErFZHasPhH6Vilu1HDinVejaYMfms8oHDsmjQ33PqUedwk
VAPID_PRIVATE_KEY=sHj0L9CjNVINju26MrfKOLV73SoIIU1npyaeNqrR0lo
