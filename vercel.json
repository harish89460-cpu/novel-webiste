{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://desert-sherman-like-ours.trycloudflare.com/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://desert-sherman-like-ours.trycloudflare.com/uploads/$1"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ]
}
